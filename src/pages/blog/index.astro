---
import Base from "/src/layouts/Base.astro";
import { url } from '/src/utils/url.js';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="blog">
	<img src={url("images/banner-blog.webp")} class="banner"/>

	<div class="read">

	<h1>blog</h1>

	<p>
	Just random cool things that come to mind,
	or other things that I think are worth writing
	notes about.
	</p>

	<ul>
		{posts.map((post) => (
			<li>
			<time datetime={post.data.date.toISOString()}>
			{post.data.date.toISOString().slice(0, 10)}
			</time> | <a href={url(`blog/${post.id}/`)}>{post.data.title}</a><br>
			<!-- {post.data.desc()} -->
			</li>
		))}
	</ul>

	</div>

</Base>
