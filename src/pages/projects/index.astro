---
import Base from "/src/layouts/Base.astro";
import { url } from '/src/utils/url.js';
---

<Base title="projects">
	<img src={url("images/banner-projects.webp")} class="banner"/>

	<div class=read>

	<h1>projects</h1>

	<p>
	Things I've built and/or currently maintain.
	</p>

	</div>

	<ul class="cards">
		<li>
			<a href="https://github.com/mulfok/obsidian-viridian" target="_blank">
				<img
					src="https://github.com/mulfok/obsidian-viridian/raw/main/cover.png"
					loading="lazy"
					decoding="async"
				/>
				<span class="card-title">obsidian-viridian</span>
				<span class="card-desc">
					A theme designed to make your time in Obsidian
					joyful and focused.
				</span>
			</a>
		</li>
		<li>
			<a href="https://github.com/mulfok/dotfiles" target="_blank">
				<img
					src="https://camo.githubusercontent.com/bcdb6032459db4a8d9265c20aa6b0b4c40e0a62ac5ffac62a2fd36d0dda962bc/68747470733a2f2f692e706f7374696d672e63632f543371486d70576e2f73637265656e73686f742d32303236313131302d3032313235322e706e67"
					loading="lazy"
					decoding="async"
				/>
				<span class="card-title">dotfiles</span>
				<span class="card-desc">
					My Linux system configuration.
				</span>
			</a>
		</li>
		<li>
			<a href="https://mulfok.carrd.co/#canis" target="_blank">
				<img
					src="https://mulfok.carrd.co/assets/images/image04.jpg"
					loading="lazy"
					decoding="async"
				/>
				<span class="card-title">
					CANIS
				</span>
				<span class="card-desc">
					DEEPHOUND's birthplace now strikes a
					nameless fear into his heart.
				</span>
			</a>
		</li>
		<li>
			<a href="https://mulfok.itch.io/kaito" target="_blank">
				<img
					src="https://img.itch.zone/aW1hZ2UvMjAxODU2NS8xMTg3MzI5Ni5naWY=/original/OLxKa5.gif"
					loading="lazy"
					decoding="async"
				/>
				<span class="card-title">
					Kaito
				</span>
				<span class="card-desc">
					A short game about a little cat mage.
				</span>
			</a>
		</li>
		<li>
			<a href="https://lospec.com/palette-list/mulfok32" target="_blank">
				<img
					src="https://cdn.lospec.com/palette-examples/mulfok32-palette-example-by-mulfok-5fba43.png"
					loading="lazy"
					decoding="async"
				/>
				<span class="card-title">
					mulfok32
				</span>
				<span class="card-desc">
					A pastel palette consisting of 32 colours.
				</span>
			</a>
		</li>
		<li>
			<a href="mulfok.itch.io/aspen" target="_blank">
				<img
					src="https://img.itch.zone/aW1nLzIxODE0MDMucG5n/original/xgGtZC.png"
					loading="lazy"
					decoding="async"
				/>
				<span class="card-title">
					Aspen
				</span>
				<span class="card-desc">
					A short, Celeste-like platformer.
				</span>
			</a>
		</li>
		<li>
			<a href="https://mulfok.itch.io/taop" target="_blank">
				<img
					src="https://img.itch.zone/aW1nLzE5ODA3NjIucG5n/original/ry6X7d.png"
					loading="lazy"
					decoding="async"
				/>
				<span class="card-title">
					The Adventures of Penguin
				</span>
				<span class="card-desc">
					My very first game.
				</span>
			</a>
		</li>
	</ul>
</Base>
