---
import { getCollection } from 'astro:content';
import Gallery from '/src/components/gallery.astro';
import Base from "/src/layouts/Base.astro";
import { url } from '/src/utils/url.js';

const works = await getCollection('portfolio');
---

<Base title="portfolio/all">
	<div class=read>
	<h1>~/portfolio/all</h1>
	<p>
	Below is an unsorted heap of everything I've made.
	<br><br>
	</p>
	</div>

	<Gallery works={works} />
</Base>
