---
import { getCollection } from 'astro:content';
import Gallery from '/src/components/gallery.astro';
import Base from "/src/layouts/Base.astro";
import { url } from '/src/utils/url.js';

const works = await getCollection('portfolio');
---

<Base title="portfolio">
	<img src={url("images/banner.jpg")} class="banner"/>

	<div class=read>

	<h1>portfolio</h1>

	<p>
	I've worked on a couple things!<br>
	You can filter through certain categories below.
	<br><br>
	<a href={url("portfolio/all")}>~/portfolio</a>
	</p>
	
	<ul>
		<li><a href={url("portfolio/pixel")}>/pixel</a></li>
		<li><a href={url("portfolio/digital")}>/digital</a></li>
		<li><a href={url("portfolio/3d")}>/3d</a></li>
		<li><a href={url("portfolio/animated")}>/animated</a></li>
		<li><a href={url("portfolio/renaine")}>/renaine</a></li>
	</ul>
	</div>
</Base>
