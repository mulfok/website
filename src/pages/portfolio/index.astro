---
import { getCollection } from 'astro:content';
import Gallery from '/src/components/gallery.astro';
import Base from "/src/layouts/Base.astro";

const works = await getCollection('portfolio');
---

<Base title="portfolio">
	<img src="images/banner.jpg" class="banner"/>

	<div class=read>

	<h1>portfolio</h1>

	<p>
	I've worked on a couple things!<br>
	You can filter through certain categories below.
	<br><br>
	~/portfolio
	</p>
	
	<ul>
		<li><a href="portfolio/pixel">/pixel</a></li>
		<li><a href="portfolio/digital">/digital</a></li>
		<li><a href="portfolio/3d">/3d</a></li>
		<li><a href="portfolio/animated">/animated</a></li>
		<li><a href="portfolio/renaine">/renaine</a></li>
	</ul>

	<p>
	<br>
	Below is an unsorted heap of everything here.
	<br><br>
	</p>
	</div>

	<Gallery works={works} />
</Base>
