---
import { getCollection } from 'astro:content';
import Gallery from '/src/components/gallery.astro';
import Base from "/src/layouts/Base.astro";
import { url } from '/src/utils/url.js';

const works = await getCollection('portfolio');
---

<Base title="portfolio">
	<img src={url("images/banner-portfolio.webp")} class="banner"/>

	<div class=read>

	<h1>portfolio</h1>

	<p>
	I've made art for all sorts of things!<br>
	You can filter through certain categories below.
	<br><br>
	<a href={url("portfolio/all")}>~/portfolio</a>
	</p>
	
	<ul>
		<li><a href={url("portfolio/pixel")}>/pixel</a></li>
		<li><a href={url("portfolio/digital")}>/digital</a></li>
		<li><a href={url("portfolio/3d")}>/3d</a></li>
		<li><a href={url("portfolio/animated")}>/animated</a></li>
		<li><a href={url("portfolio/renaine")}>/renaine</a></li>
	</ul>

	<p>
	<br>
	If you're looking to <i>commission me,</i> send me a DM on
	Discord (@mulfok). I'm currently organising a proper
	platform for my commission stuff, but until then I'll
	provide details by message.
	<br><br>
	Have a <i>business enquiry,</i> or are looking to <i>hire me
	</i> for some project? Please email me at <i>mulfok dot
	kallan at gmail dot com.</i>
	
	<br><br>
	I generally respond within a day or two.
	</p>

	<h2>achievements</h2>

	<p>
	 
	</p>
	</div>
</Base>
