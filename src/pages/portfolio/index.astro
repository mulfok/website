---
import { getCollection } from 'astro:content';
import Gallery from '/src/components/gallery.astro';
import Base from "/src/layouts/Base.astro";
import { url } from '/src/utils/url.js';

const works = await getCollection('portfolio');
---

<Base title="portfolio">
	<img src={url("images/banner-portfolio.webp")} class="banner"/>

	<div class=read>

	<h1>portfolio</h1>

	<p>
	I've made art for all sorts of things!<br>
	You can filter through certain categories below.
	</p>
	
	<ul>
		<li><a href={url("portfolio/all")}>/all</a> <span style="color: var(--color-muted);"><-- everything</span></li>
		<li><a href={url("portfolio/pixel")}>/pixel</a></li>
		<li><a href={url("portfolio/digital")}>/digital</a></li>
		<li><a href={url("portfolio/3d")}>/3d</a></li>
		<li><a href={url("portfolio/animated")}>/animated</a></li>
		<li><a href={url("portfolio/renaine")}>/renaine</a></li>
	</ul>

	<h2>commissions</h2>

	<p>
	If you're looking to <i>commission me,</i> check out my <a href="https://mulfok.carrd.co/#commissions">
	old commissions page,</a> and then send me a DM on Discord (@mulfok).
	I'm currently organising a new platform for commissioning me,
	but until then details are still at the old site.
	</p>

	<h2>business</h2>

	<p>
	Have a <i>business enquiry,</i> or are looking to <i>hire me
	</i> for some project? Please email me at <b>mulfok dot
	kallan at gmail dot com.</b>
	</p>
	
	<p>I generally respond within a day or two.</p>

	<h2>experience</h2>

	<p>
	<b>Pixel Artist | 2024 - Present</b><br>
	Unannounced Game
	</p>

	<p>
	<b>Pixel Artist | May 2025 - December 2025</b><br>
	Renaine @ Octosoft, Limited Run Games
	</p>
	
	<p>
	<b>Freelance | 2022 - Present</b><br>
	</p>

	<h2>software</h2>

	<p>Programmes I'm proficient in!</p>

	<ul>
		<li>Aseprite</li>
		<li>Clip Studio Paint</li>
		<li>Krita</li>
		<li>Blender</li>
		<li>GameMaker Studio</li>
		<li>Adobe Suite
			<ul>
				<li>Photoshop</li>
				<li>Illustrator</li>
			</ul>
		</li>
		<li>Autodesk
			<ul>
				<li>After Effects</li>
				<li>3DS Max</li>
				<li>Maya</li>
			</ul>
		</li>
	</ul>

	<h2>achievements</h2>

	<ul>
		<li>Tall Ships Races | to Kristiansand | 2025</li>
		<li>Kickboxing | 1st Dan Black Belt | December 2024</li>
		<li>Kickboxing | Bo Dan Black Belt | June 2024</li>
	</ul>

	</div>
</Base>
